# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets. .env.example is a safe, values-free
# template and is deliberately un-ignored below.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase local dev artifacts (never contains anything meant to be shared)
supabase/.temp
supabase/.branches

# editor / OS
.vscode/*
!.vscode/extensions.json
.idea
Thumbs.db
Desktop.ini

# logs
*.log
logs/
