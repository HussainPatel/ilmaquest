# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored — never commit real keys. See docs/SECURITY.md §4.

# Public — safe to expose to the browser (Supabase enforces access via RLS, not secrecy of this key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — server-side only, bypasses Row-Level Security. Never prefix with NEXT_PUBLIC_,
# never send to the client, never use in the Chrome extension.
SUPABASE_SERVICE_ROLE_KEY=

# SECRET — server-side only. Used for the content-draft AI assist (see docs/CONTENT_PROCESS.md §5).
ANTHROPIC_API_KEY=

# SECRET — server-side only. Stripe API access for donations (see docs/MONETIZATION.md).
# PLACEHOLDER — no real Stripe account exists yet. Get a test-mode key (sk_test_...)
# from your own Stripe dashboard once you create an account; never use a live key locally.
STRIPE_SECRET_KEY=

# SECRET — server-side only. Verifies incoming Stripe webhook payloads are genuine
# (see docs/MONETIZATION.md §4). PLACEHOLDER — from the Stripe CLI (`stripe listen`)
# for local dev, or the dashboard's webhook endpoint config for production.
STRIPE_WEBHOOK_SECRET=

# Optional — flips donation UI copy between generic "support us" wording and
# charity/tax-deductible wording. Defaults to false. See docs/MONETIZATION.md §5 —
# do not set true without also implementing real tax-receipt content.
ORG_IS_REGISTERED_NONPROFIT=false
